<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= note.path %> | Now Note</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="shortcut icon" href="/f_silver.png" type="image/x-icon">
  <style>

  body { 
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    padding: 0;
    margin: 0;
    background: #191919;
    height: 100vh;
    overflow: hidden;
  }

input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active {
  transition: background-color 9999s ease-in-out 0s !important;
  -webkit-text-fill-color: rgba(255, 255, 255, 0.9) !important;
  -webkit-box-shadow: 0 0 0px 1000px transparent inset !important;
}

#noteArea { 
  border-radius: 0;
  width: 100%; 
  height: calc(100vh - 65px);
  padding: 60px 96px;
  font-size: 16px;
  line-height: 1.5;
  outline: none;
  background-color: #191919;
  border: none;
  color: rgba(255, 255, 255, 0.9);
  resize: none;
  box-sizing: border-box;
  
}

header {
  background: #191919;
  border-bottom: 1px solid rgba(255, 255, 255, 0.09);
  height: 65px;
  padding: 0 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: none;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  background: transparent;
  border: none;
  padding: 0;
  height: auto;
  border-radius: 0;
  transition: none;
}

.search-bar:hover {
  background: transparent;
  transform: none;
}

.search-bar button {
  font-size: 18px;
  color: rgba(255, 255, 255, 0.5);
  background: none;
  border: none;
  padding: 4px;
  cursor: pointer;
  transition: 0.15s;
  border-radius: 3px;
}

.search-bar button:hover {
  transform: none;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.08);
}

h1 {
  font-size: 14px;
  font-weight: 500;
  margin: 0;
  color: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
}

#inputPath {
  font-size: 14px;
  font-weight: 500;
  background: none;
  border: none;
  outline: none;
  color: rgba(255, 255, 255, 0.9);
  margin-left: 4px;
}

.save-warn {
  position: fixed;
  display: none;
  top: 50px;
  right: 20px;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  font-size: 13px;
  background: #2f2f2f;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  padding: 8px 12px;
  border-radius: 3px;
}

.buttonsHeader {
  display: flex;
  align-items: center;
  gap: 8px;
}

header button {
  border: none;
  background: transparent;
  color: rgba(255, 255, 255, 0.5);
  padding: 6px 8px;
  border-radius: 3px;
  cursor: pointer;
  font-size: 18px;
  display: flex;
  align-items: center;
  transition: 0.15s;
}

header button:hover {
  background: rgba(255, 255, 255, 0.08);
  color: rgba(255, 255, 255, 0.9);
  transform: none;
}

.infoBox {
  position: absolute;
  top: 70px;
  right: 24px;
  width: 300px;
  z-index: 15;
  background: #2f2f2f;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 3px;
  padding: 16px;
  color: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  gap: 12px;
  opacity: 0;
  transform: translateY(-8px);
  pointer-events: none;
  transition: 0.2s ease;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
}

.infoBox:not(.hidden) {
  opacity: 1;
  transform: translateY(0);
  pointer-events: all;
}

.infoBox span {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.5);
  text-align: center;
  margin-top: 8px;
}

.infoBox span a {
  color: rgba(255, 255, 255, 0.9);
  text-decoration: underline;
  cursor: pointer;
}

.imagesBox {
  position: absolute;
  top: 70px;
  right: 24px;
  z-index: 15;
  width: 450px;
  max-width: 100%;
  background: #2f2f2f;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 3px;
  padding: 16px;
  color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  opacity: 0;
  transform: translateY(-8px);
  pointer-events: none;
  transition: 0.2s ease;
}

.imagesBox:not(.hidden) {
  opacity: 1;
  transform: translateY(0);
  pointer-events: all;
}

.bottom-bar {
  margin-top: 12px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: rgba(255, 255, 255, 0.5);
}

.bottom-bar button {
  width: 100%;
  height: 2rem;
  margin-top: 12px;
  cursor: pointer;
  background-color: #2383e2;
  border: none;
  color: #fff;
  border-radius: 3px;
  font-size: 14px;
  font-weight: 500;
  transition: 0.15s;
}

.bottom-bar button:hover {
  background-color: #1a73d1;
}

.images {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: 8px;
  width: 95%;
  max-height: 60vh;
  overflow-y: auto;
  overflow-x: hidden;
}

.images::-webkit-scrollbar {
  width: 8px;
}

.images::-webkit-scrollbar-track {
  background: transparent;
}

.images::-webkit-scrollbar-thumb {
  background-color: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}

.images::-webkit-scrollbar-thumb:hover {
  background-color: rgba(255, 255, 255, 0.2);
}

.img-box {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
}

.buttonsImg {
  position: absolute;
  top: 8px;
  right: 8px;
}

.buttonsImg button, .buttonsImg a {
  padding: 4px;
  margin: 0 2px;
  border: none;
  background: rgba(0, 0, 0, 0.6);
  color: #eb5757;
  font-size: 16px;
  border-radius: 3px;
  transition: 0.15s;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

.buttonsImg button:hover {
  background: rgba(0, 0, 0, 0.8);
  transform: scale(1.05);
}

.imagem {
  width: 100%;
  height: 150px;
  object-fit: cover;
  border-radius: 3px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  transition: transform 0.15s;
  margin: 6px 0;
  cursor: pointer;
}

.imagem:hover {
  transform: scale(1.02);
}

.hidden {
  display: none;
}

#modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.9);
  display: none;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

#modal img {
  max-width: 90%;
  max-height: 90%;
  border-radius: 3px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
}

#modalClose {
  position: absolute;
  top: 20px;
  right: 30px;
  color: white;
  font-size: 36px;
  font-weight: normal;
  cursor: pointer;
  transition: 0.15s;
}

#modalClose:hover {
  opacity: 0.7;
}

.full-screen {
  position: fixed;
  border: none !important;
  background: #191919 !important;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh !important;
  z-index: 9999;
  font-size: 1.2em;
  border-radius: 0 !important;
  padding: 40px 96px !important;
}

@media (max-width: 768px) {

  body {
    padding: 0;
  }

  header {
    flex-direction: column;
    height: auto;
    padding: 12px 16px;
    gap: 12px;
  }

  #noteArea {
    height: calc(100vh - 140px);
    padding: 24px 16px;
  }

  .search-bar {
    width: 100%;
  }

  .search-bar h1 {
    width: 100%;
  }

  h1, #inputPath {
    font-size: 14px;
  }

  .buttonsHeader {
    width: 100%;
    gap: 8px;
  }

  .buttonsHeader button {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 8px 12px;
  }

  header button {
    font-size: 18px;
  }

  .infoBox,
  .imagesBox {
    top: 25%;
    left: 50%;
    right: auto;
    transform: translateX(-50%) translateY(-8px);
    width: 80%;
  }

  .infoBox:not(.hidden),
  .imagesBox:not(.hidden) {
    transform: translateX(-50%) translateY(0);
  }

  .full-screen {
    padding: 24px 16px !important;
  }
}

</style>



</head>
<body>
  <header>
    <div class="search-bar">
      <h1>/<input type="text" id="inputPath" value="<%= note.path %>" autocapitalize="off"></input></h1>
      <button id="btnSearchNote"><i class="bi bi-search"></i></button>
    </div>
    <div class="buttonsHeader">
      <button id="btnImages"><i class="bi bi-images"></i></button>
      <button id="btnInfo"><i class="bi bi-info-circle"></i></button>
    </div>
  </header>

  <div class="infoBox hidden">
    <div>
      <p>Use "F" para modo tela cheia e "ESC" para sair.</p>
      <p>Acesse outra nota pela URL ou pela barra de busca.</p>
    </div>

    <span>Made by <a href="https://github.com/Lipe7k" target="_blank">Felipe Falcirolli</a></span>
  </div>



  <div class="imagesBox hidden">
    <div class="images">
      <% if (note.images && note.images.length > 0) { %>
        <% note.images.forEach(image => { %>
          <% if (image.path) { %>
            <div class="img-box">
              <img 
                src="<%= image.path %>" 
                alt="imagem" 
                class="imagem" 
                data-note="<%= note._id %>" 
                data-path="<%= image.path %>">
              <div class="buttonsImg">
                <a style="color: white;" href="<%= image.path %>" target="_blank">
                  <i class="bi bi-upload"></i>
                </a>
                <button class="deleteBtn" 
                  data-note="<%= note._id %>" 
                  data-path="<%= image.path %>">
                  <i class="bi bi-trash"></i>
                </button>
              </div>

            </div>
          <% } %>
        <% }) %>
      <% } %>
    </div>

    <div class="bottom-bar">
      <span id="fileName">Nenhum arquivo selecionado</span>
      <button id="uploadBtn">Add <i class="bi bi-plus"></i></button>
    </div>
  </div>

  <form id="noteForm" action="/<%= note.path %>" method="POST" enctype="multipart/form-data">
    <textarea name="content" id="noteArea" spellcheck="false"><%= note.content %></textarea>
    <input id="imagesInput" type="file" name="images" style="display: none;" multiple>
  </form>

  <div class="save-warn">Salvando...</div>

  <div id="modal">
    <span id="modalClose">&times;</span>
    <img id="modalImg" src="" alt="Imagem grande">
  </div>

  <script>
        const inputPath = document.querySelector("#inputPath")
        const btnSearchNote = document.querySelector('#btnSearchNote')

        btnSearchNote.addEventListener('click', () => {
          window.location.href = "/" + inputPath.value
        })

        inputPath.addEventListener("keydown", (e) =>{
          if (e.key === "Enter"){
            window.location.href = "/" + inputPath.value
          }
        })

        const infoBox = document.querySelector('.infoBox')
        const imagesBox = document.querySelector('.imagesBox')
        const btnInfo = document.querySelector('#btnInfo')
        const btnImages = document.querySelector('#btnImages')

        btnInfo.addEventListener("click", () => {
          const open = !infoBox.classList.contains("hidden")
          infoBox.classList.toggle("hidden")
          imagesBox.classList.add("hidden")
        })

        btnImages.addEventListener("click", () => {
          const open = !imagesBox.classList.contains("hidden")
          imagesBox.classList.toggle("hidden")
          infoBox.classList.add("hidden")
        })

        document.addEventListener("click", e => {
          const insideInfo = infoBox.contains(e.target) || btnInfo.contains(e.target)
          const insideImages = imagesBox.contains(e.target) || btnImages.contains(e.target)
          
          if (!insideInfo) infoBox.classList.add("hidden")
          if (!insideImages) imagesBox.classList.add("hidden")
        })


        const fileInput = document.querySelector("#imagesInput")
        const uploadBtn = document.querySelector("#uploadBtn")
        const fileName = document.querySelector("#fileName")

        uploadBtn.addEventListener("click", () => { fileInput.click() })
        fileInput.addEventListener("change", () => {
          fileName.textContent = fileInput.files[0] ? fileInput.files[0].name : "Nenhum arquivo selecionado"
        })

        const form = document.getElementById("noteForm")
        const textarea = document.getElementById("noteArea")

        document.addEventListener('keydown', (e) => {

          if (e.key.toLowerCase() === 'f' && document.activeElement !== textarea && document.activeElement !== inputPath) {
            textarea.classList.toggle('full-screen');
          }


          if (e.key === 'Escape' && textarea.classList.contains('full-screen')) {
            textarea.classList.remove('full-screen');
          }
        });

        async function submitForm(){ await fetch("/<%= note.path %>", { method:"POST", body: new FormData(form) }) }

        const save = document.querySelector(".save-warn")

        let timeout;

        textarea.addEventListener("input", () => {
          clearTimeout(timeout)
          save.style.display = "block"
          timeout = setTimeout(() => { 
          submitForm()
          save.style.display = "none"
        }, 2000)
        })

        fileInput.addEventListener("change", async () => {
          save.style.display="block";

          await submitForm();

          save.style.display="none"
          window.location.reload()
        })

        const modal = document.getElementById("modal")
        const modalImg = document.getElementById("modalImg")
        const modalClose = document.getElementById("modalClose")

        document.querySelectorAll(".imagem").forEach(img => {
          img.addEventListener("click", () => {
            modalImg.src = img.src
            modal.style.display = "flex"
          })
        })

        modalClose.addEventListener("click", () => modal.style.display = "none")
        modal.addEventListener("click", (e) => {
          if(e.target === modal) modal.style.display = "none"
        })


      document.querySelectorAll(".deleteBtn").forEach(btn => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();

        const noteId = btn.dataset.note;
        const imagePath = btn.dataset.path;

        if (!noteId || !imagePath) return;

        try {
          const res = await fetch("/delete-image", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ noteId, imagePath })
          });

          const data = await res.json();
          if (data.success) {
            btn.closest(".img-box").remove();
          } else {
            console.error(data.error);
          }
        } catch (err) {
          console.error("Erro no fetch:", err);
        }
      });
    });


  </script>
</body>
</html>
